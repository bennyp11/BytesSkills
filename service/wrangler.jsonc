{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bytesskills-mvp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "account_id": "f6c273ea7837c6c7b5cdab3cdaa905c7",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.bytesskills.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "BASE_URL": "https://api.bytesskills.com",
    "WORKSPACE_ID": "acc3351e-d092-433c-a7e1-8fc3e807ebd4",
    "STORAGE_BACKEND": "postgres"
  },
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "bytesskills-mvp-blobs"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "4716622bf06e4b4080adb6f78d251757"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "limits": {
    "cpu_ms": 10000
  },
  "hyperdrive": [
    {
      "binding": "POSTGRES",
      "id": "215663e431854e0c8d79ee6918b11ede"
    },
    {
      "binding": "PUBLISHER_DB",
      "id": "254d320b652d4402a73f25024e4599ce"
    }
  ]
}
