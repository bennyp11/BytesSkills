{
  "name": "bytesskills-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/bundle-library.mjs && wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "build": "node scripts/bundle-library.mjs && wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "miniflare": "^5.20261006.1-alpha",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
