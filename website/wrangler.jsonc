{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bytesskills-website",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "f6c273ea7837c6c7b5cdab3cdaa905c7",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bytesskills.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bytesskills-mvp",
      "database_id": "952f6010-c5de-4c0a-8485-cb0ae30f6f1a",
      "migrations_dir": "migrations",
      "migrations_table": "website_d1_migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
